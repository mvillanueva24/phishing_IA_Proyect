# GEMINI_API_KEY: Required for server-side fallback classification when local FastAPI is not running.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FASTAPI_URL: URL of the FastAPI backend running backend/main.py with IA_dataset/beto-phishing-final
FASTAPI_URL="http://127.0.0.1:8000"
